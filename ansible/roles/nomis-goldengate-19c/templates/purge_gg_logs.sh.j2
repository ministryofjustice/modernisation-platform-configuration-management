#!/bin/bash
#
# purge_gg_logs.sh
#
# Deletes old GoldenGate report files and MoJ GoldenGate operational logs.
#
# Generated by Ansible - do not edit manually.

set -u
set -o pipefail

REPORT_DIR="{{ oracle_goldengate_report_dir }}"
ADMIN_LOG_DIR="{{ oracle_goldengate_log_dir }}"

REPORT_RETENTION_DAYS="{{ oracle_goldengate_report_log_retention_days }}"
ADMIN_LOG_RETENTION_DAYS="{{ oracle_goldengate_admin_log_retention_days }}"

LOG_FILE="${ADMIN_LOG_DIR}/purge_gg_logs_cron.log"

mkdir -p "${ADMIN_LOG_DIR}"

exec >"${LOG_FILE}" 2>&1

echo "=== GoldenGate log purge started: $(date '+%Y-%m-%d %H:%M:%S') ==="
echo "Report directory      : ${REPORT_DIR}"
echo "Report retention      : ${REPORT_RETENTION_DAYS} days"
echo "Operational log dir   : ${ADMIN_LOG_DIR}"
echo "Operational retention : ${ADMIN_LOG_RETENTION_DAYS} days"

purge_directory() {
    local directory="$1"
    local retention_days="$2"
    local description="$3"
    local exclude_file="${4:-}"

    if [ ! -d "${directory}" ]; then
        echo "WARNING: ${description} directory does not exist: ${directory}"
        return 0
    fi

    echo ""
    echo "Purging ${description} older than ${retention_days} days"

    if [ -n "${exclude_file}" ]; then
        find "${directory}" \
            -xdev \
            -maxdepth 1 \
            -type f \
            -mtime "+${retention_days}" \
            ! -name "${exclude_file}" \
            -print \
            -delete
    else
        find "${directory}" \
            -xdev \
            -maxdepth 1 \
            -type f \
            -mtime "+${retention_days}" \
            -print \
            -delete
    fi

    local rc=$?

    if [ "${rc}" -ne 0 ]; then
        echo "ERROR: Failed while purging ${description}"
        return "${rc}"
    fi

    echo "Completed purge of ${description}"
}

# GoldenGate report and discard files in dirrpt.
#
# Restrict deletion to ordinary files directly within dirrpt. This avoids
# following links or unexpectedly traversing any future subdirectories.
purge_directory \
    "${REPORT_DIR}" \
    "${REPORT_RETENTION_DAYS}" \
    "GoldenGate report files"

# Do not delete this script's current output log while it is open.
purge_directory \
    "${ADMIN_LOG_DIR}" \
    "${ADMIN_LOG_RETENTION_DAYS}" \
    "GoldenGate operational logs" \
    "$(basename "${LOG_FILE}")"

echo ""
echo "=== GoldenGate log purge completed: $(date '+%Y-%m-%d %H:%M:%S') ==="
