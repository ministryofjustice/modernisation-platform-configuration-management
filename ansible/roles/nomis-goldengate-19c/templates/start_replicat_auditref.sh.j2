#!/bin/bash
# GoldenGate Audit Reference Replicat Start Script
# Generated by Ansible

ORACLE_SID={{ oracle_goldengate_group.auditref.tns_alias }}
ORAENV_ASK=NO
. oraenv > /dev/null

GGHOME={{ oracle_goldengate_home }}
REPLICAT_NAME={{ oracle_goldengate_group.auditref.replicat_name }}
LOG={{ oracle_goldengate_log_dir }}/ogg_control.log
OEM_AGENT_HOME=/u01/app/oracle/product/oem-agent/agent_13.5.0.0.0

cd ${GGHOME}

# if SCN passed in as an argument, use it to start the replicat
if [ $# -eq 1 ]; then
    SCN=$1
    echo "Starting Replicat ${REPLICAT_NAME} with SCN ${SCN}..."
    START=", AFTERSCN ${SCN}"
else
    echo "Starting Replicat ${REPLICAT_NAME}..."
    START=""
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') - START REPLICAT ${REPLICAT_NAME} ${START}" >>"$LOG"

./ggsci << EOF >>"$LOG" 2>&1
START REPLICAT ${REPLICAT_NAME} ${START}
INFO REPLICAT ${REPLICAT_NAME}
EXIT
EOF

if [ $? -eq 0 ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Replicat ${REPLICAT_NAME} started successfully" >>"$LOG"
    echo "Replicat ${REPLICAT_NAME} started successfully"
    echo "Stopping blackout"
    $OEM_AGENT_HOME/bin/emctl stop blackout goldengate_maintenance_${ORACLE_SID}
    exit 0
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - FAILED to start Replicat ${REPLICAT_NAME}" >>"$LOG"
    echo "Failed to start Replicat ${REPLICAT_NAME}"
    exit 1
fi
