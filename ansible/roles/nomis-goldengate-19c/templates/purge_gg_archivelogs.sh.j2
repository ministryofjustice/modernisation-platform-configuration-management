#!/bin/bash
# purge_gg_archivelogs.sh
# Purge foreign archived redo logs from ASM once they are no longer required
# for GoldenGate downstream integrated capture recovery.
#
# Oracle does not automatically purge foreign archived logs shipped to a
# downstream mining database.  Purge decisions are anchored to the GoldenGate
# Extract Recovery Checkpoint timestamps (the oldest position any extract must
# be able to restart from), minus a configurable safety retention buffer.
#
# On Oracle 12c+, RMAN DELETE FOREIGN ARCHIVELOG is used.
# On Oracle 11g, logs shipped with NOREGISTER are not registered in the control
# file, so RMAN cannot see them. Instead, we query DBA_REGISTERED_ARCHIVED_LOG
# for purgeable logs and remove them directly from ASM using asmcmd rm.
#
# Generated by Ansible - do not edit manually.
# The database SID of the local mining database must be passed as the first argument to this script.

PATH=/usr/local/bin:/bin:/usr/bin:/usr/local/sbin:/usr/sbin
GG_HOME="{{ oracle_goldengate_home }}"
LOG_DIR="{{ oracle_goldengate_log_dir }}"
RETENTION_HOURS="{{ oracle_goldengate_archivelog_retention_hours }}"
ORA_VERSION="{{ ora_version }}"
SOURCE_SID="{{ oracle_goldengate_group.source.tns_alias }}"
DEFAULT_RECOVERY_CHECKPOINT=""
LOCAL_SID="$1"

LOG_FILE="${LOG_DIR}/purge_archivelogs_cron.log"
mkdir -p "$LOG_DIR"
exec > "$LOG_FILE" 2>&1

echo "=== GoldenGate Foreign Archivelog Purge: $(date) ==="
echo "Mining database  : ${LOCAL_SID}"
echo "Oracle version   : ${ORA_VERSION}"
echo "Retention buffer : ${RETENTION_HOURS} hours beyond extract recovery checkpoint"

# ---------------------------------------------------------------------------
# Oracle environment setup - done once for the local mining database
# ---------------------------------------------------------------------------
export ORACLE_SID="${LOCAL_SID}"
export ORAENV_ASK=NO
. oraenv >/dev/null 2>&1
export PATH=${ORACLE_HOME}/bin:$PATH

# ---------------------------------------------------------------------------
# get_recovery_checkpoint_time EXTRACT_NAME
#
# Queries DBA_CAPTURE for the captured_scn and maps it to a timestamp via
# DBA_REGISTERED_ARCHIVED_LOG.  Prints "YYYY-MM-DD HH:MM:SS" to stdout,
# or nothing on failure.
# ---------------------------------------------------------------------------
get_recovery_checkpoint_time() {
    local extract_name="$1"

    local chk_time
    chk_time=$(sqlplus -s / as sysdba <<EOF
SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF
SELECT to_char(max(first_time),'YYYY-MM-DD HH:MM:SS') FROM DBA_REGISTERED_ARCHIVED_LOG 
WHERE first_scn = (SELECT captured_scn FROM DBA_CAPTURE WHERE client_name = UPPER('${extract_name}'));
EXIT;
EOF
)
    echo "$chk_time"
}

# ---------------------------------------------------------------------------
# calc_purge_cutoff ORACLE_SID EXTRACT_NAME [EXTRACT_NAME ...]
#
# Determines the oldest Recovery Checkpoint timestamp across all supplied
# extracts then subtracts RETENTION_HOURS.  Prints the resulting cutoff
# timestamp to stdout.  Returns 1 (aborting the purge) if the checkpoint
# cannot be determined for any extract, to avoid premature deletion.
# ---------------------------------------------------------------------------
calc_purge_cutoff() {
    local oracle_sid="$1"
    shift
    local extracts=("$@")

    local oldest_epoch=""

    for extract in "${extracts[@]}"; do
        local chk_time
        chk_time=$(get_recovery_checkpoint_time "$extract")

        if [ -z "$chk_time" ]; then
            # set DEFAULT_RECOVERY_CHECKPOINT to today minus 7 days if the checkpoint cannot be parsed, to avoid deleting all archived logs
            DEFAULT_RECOVERY_CHECKPOINT=$(date -d "7 days ago" '+%Y-%m-%d %H:%M:%S')
            echo "WARNING: Could not parse checkpoint timestamp '${chk_time}' for extract ${extract} on ${oracle_sid}" \
                 "- using default checkpoint ${DEFAULT_RECOVERY_CHECKPOINT} to avoid deleting all archived logs" >&2
            chk_time="$DEFAULT_RECOVERY_CHECKPOINT"
        fi

        echo "  ${extract} recovery checkpoint : ${chk_time}" >&2

        local epoch
        epoch=$(date -d "$chk_time" '+%s' 2>/dev/null)

        if [ -z "$epoch" ]; then
            echo "ERROR: Could not parse checkpoint timestamp '${chk_time}'" \
                 "for extract ${extract}" >&2
            return 1
        fi

        if [ -z "$oldest_epoch" ] || [ "$epoch" -lt "$oldest_epoch" ]; then
            oldest_epoch="$epoch"
        fi
    done

    local cutoff_epoch=$(( oldest_epoch - RETENTION_HOURS * 3600 ))
    date -d "@${cutoff_epoch}" '+%Y-%m-%d %H:%M:%S'
}

# ---------------------------------------------------------------------------
# purge_foreign_archivelogs_rman ORACLE_SID CUTOFF_TIMESTAMP
#
# Oracle 12c+ method: Invokes RMAN to delete foreign archived logs completed
# before CUTOFF using the DELETE FOREIGN ARCHIVELOG command.
# ---------------------------------------------------------------------------
purge_foreign_archivelogs_rman() {
    local oracle_sid="$1"
    local cutoff_time="$2"

    # Calculate days between now and cutoff for RMAN SYSDATE-N syntax
    local cutoff_epoch
    cutoff_epoch=$(date -d "$cutoff_time" '+%s')
    local now_epoch
    now_epoch=$(date '+%s')
    local diff_seconds=$(( now_epoch - cutoff_epoch ))
    local diff_days=$(echo "scale=4; ${diff_seconds} / 86400" | bc)

    echo ""
    echo "Connecting RMAN to ${oracle_sid} (12c+ method)"
    echo "Deleting foreign archived logs completed before: ${cutoff_time} (SYSDATE-${diff_days})"

    rman target / nocatalog <<EOF
DELETE NOPROMPT FOREIGN ARCHIVELOG ALL COMPLETED BEFORE 'SYSDATE-${diff_days}';
EXIT;
EOF
    local rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "WARNING: RMAN exited with return code ${rc} for ${oracle_sid}" >&2
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# purge_foreign_archivelogs_asmcmd ORACLE_SID CUTOFF_TIMESTAMP
#
# Oracle 11g method: Logs shipped with NOREGISTER are not in the control file
# so RMAN cannot manage them. Instead query DBA_REGISTERED_ARCHIVED_LOG for
# purgeable logs (those fully consumed by GoldenGate) and remove them from
# ASM directly using asmcmd rm. Also removes any archive log files on disk
# that are older than the cutoff based on the ASM directory date structure.
# ---------------------------------------------------------------------------
purge_foreign_archivelogs_asmcmd() {
    local oracle_sid="$1"
    local cutoff_time="$2"
    local archivelog_path="+DATA/${oracle_sid}/${SOURCE_SID}_ARCHIVELOGS"

    echo ""
    echo "Using 11g asmcmd method for ${oracle_sid}"
    echo "Archive log path: ${archivelog_path}"
    echo "Cutoff time: ${cutoff_time}"

    # Method 1: Delete logs marked PURGEABLE in DBA_REGISTERED_ARCHIVED_LOG
    echo ""
    echo "Querying DBA_REGISTERED_ARCHIVED_LOG for purgeable logs..."

    local purgeable_query="SELECT distinct upper(name) FROM dba_registered_archived_log WHERE source_database IS NOT NULL AND upper(name) like upper('+DATA/${oracle_sid}/${SOURCE_SID}_ARCHIVELOGS/%') AND modified_time BETWEEN TO_DATE('${cutoff_time}','YYYY-MM-DD HH24:MI:SS')-3 AND TO_DATE('${cutoff_time}','YYYY-MM-DD HH24:MI:SS') order by upper(name);"
    echo "  SQL: ${purgeable_query}"

    local purgeable_logs
    purgeable_logs=$(sqlplus -s / as sysdba <<EOF
SET PAGESIZE 0 FEEDBACK OFF VERIFY OFF HEADING OFF ECHO OFF LINESIZE 512 TRIMOUT ON TRIMSPOOL ON
${purgeable_query}
EXIT;
EOF
)

    #echo "  Result: [${purgeable_logs}]"

    local purge_count=0
    if [ -n "$purgeable_logs" ]; then
        echo "Found purgeable logs - removing from ASM..."
        while IFS= read -r logfile; do
            # Skip empty lines and whitespace
            logfile=$(echo "$logfile" | xargs)
            # Only process lines that look like ASM paths
            if [[ ! "$logfile" =~ ^\+ ]]; then
                continue
            fi
            echo "  Removing: ${logfile}"
            # Switch to ASM instance for asmcmd
            export ORACLE_SID=+ASM
            export ORAENV_ASK=NO
            . oraenv >/dev/null 2>&1
            asmcmd rm -f "$logfile" 2>/dev/null
            purge_count=$((purge_count + 1))
        done <<< "$purgeable_logs"
    else
        echo "  No purgeable logs found in DBA_REGISTERED_ARCHIVED_LOG"
    fi

    echo ""
    echo "Purge complete for ${oracle_sid}: ${purge_count} items removed"
    # Switch back to mining DB
    export ORACLE_SID="${oracle_sid}"
    export ORAENV_ASK=NO
    . oraenv >/dev/null 2>&1
    return 0
}

# ---------------------------------------------------------------------------
# purge_foreign_archivelogs ORACLE_SID CUTOFF_TIMESTAMP
#
# Dispatches to the appropriate purge method based on Oracle version.
# ---------------------------------------------------------------------------
purge_foreign_archivelogs() {
    local oracle_sid="$1"
    local cutoff_time="$2"

    if [ "$ORA_VERSION" = "ORA11g" ]; then
        purge_foreign_archivelogs_asmcmd "$oracle_sid" "$cutoff_time"
    else
        purge_foreign_archivelogs_rman "$oracle_sid" "$cutoff_time"
    fi
}

# ---------------------------------------------------------------------------
# Rotate old purge log files - keep the last 30 days
# ---------------------------------------------------------------------------
find "$LOG_DIR" -maxdepth 1 -name 'purge_archivelogs_*.log' -mtime +30 -delete 2>/dev/null || true

# ---------------------------------------------------------------------------
# Main - determine which extracts are relevant for the local mining database
# ---------------------------------------------------------------------------
case "$LOCAL_SID" in
    "{{ oracle_goldengate_group.auditdata.tns_alias }}")
        echo ""
        echo "--- Audit mining database (${LOCAL_SID}) ---"
        EXTRACTS=(
            "{{ oracle_goldengate_group.auditdata.extract_name }}"
            "{{ oracle_goldengate_group.auditref.extract_name }}"
        )

        CUTOFF=$(calc_purge_cutoff "$LOCAL_SID" "${EXTRACTS[@]}") || {
            echo "Purge skipped for ${LOCAL_SID} - checkpoint lookup failed"
            exit 1
        }

        echo "  Oldest checkpoint - ${RETENTION_HOURS}h buffer = ${CUTOFF}"
        purge_foreign_archivelogs "$LOCAL_SID" "$CUTOFF"
        ;;

    "{{ oracle_goldengate_group.mis.tns_alias }}")
        echo ""
        echo "--- MIS mining database (${LOCAL_SID}) ---"
        EXTRACTS=(
            "{{ oracle_goldengate_group.mis.extract_name }}"
        )

        CUTOFF=$(calc_purge_cutoff "$LOCAL_SID" "${EXTRACTS[@]}") || {
            echo "Purge skipped for ${LOCAL_SID} - checkpoint lookup failed"
            exit 1
        }

        echo "  Oldest checkpoint - ${RETENTION_HOURS}h buffer = ${CUTOFF}"
        purge_foreign_archivelogs "$LOCAL_SID" "$CUTOFF"
        ;;

    "")
        echo "oracle_goldengate_local_db_sid is not set - nothing to purge"
        exit 0
        ;;

    *)
        echo "No downstream mining database recognised on this host" \
             "(oracle_goldengate_local_db_sid='${LOCAL_SID}')"
        exit 0
        ;;
esac

echo ""
echo "=== Purge completed: $(date) ==="
