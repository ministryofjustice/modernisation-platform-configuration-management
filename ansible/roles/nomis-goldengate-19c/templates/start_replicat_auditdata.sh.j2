#!/bin/bash
# GoldenGate Audit Data Replicat Start Script
# Generated by Ansible

ORACLE_SID={{ oracle_goldengate_group.auditdata.tns_alias }}
ORAENV_ASK=NO
. oraenv > /dev/null

GGHOME={{ oracle_goldengate_home }}
REPLICAT_NAME={{ oracle_goldengate_group.auditdata.replicat_name }}
LOG={{ oracle_goldengate_log_dir }}/ogg_control.log

cd ${GGHOME}

# if SCN passed in as an argument, use it to start the replicat
if [ $# -eq 1 ]; then
    SCN=$1
    echo "Starting Replicat ${REPLICAT_NAME} with SCN ${SCN}..."
    START=", AFTERSCN ${SCN}"
else
    echo "Starting Replicat ${REPLICAT_NAME}..."
    START=""
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') - START REPLICAT ${REPLICAT_NAME} ${START}" >>"$LOG"

./ggsci << EOF >>"$LOG" 2>&1
START REPLICAT ${REPLICAT_NAME} ${START}
INFO REPLICAT ${REPLICAT_NAME}
EXIT
EOF

if [ $? -eq 0 ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Replicat ${REPLICAT_NAME} started successfully" >>"$LOG"
    echo "Replicat ${REPLICAT_NAME} started successfully with ${START}"
    exit 0
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - FAILED to start Replicat ${REPLICAT_NAME}" >>"$LOG"
    echo "Failed to start Replicat ${REPLICAT_NAME} with ${START}"
    exit 1
fi
