#!/bin/bash
# Sync AUDITDATA placeholder tables to match source schema structure
# Generated by Ansible

set -u

PATH=/usr/local/bin:/bin:/usr/bin:/usr/local/sbin:/usr/sbin
LOG_DIR={{ oracle_goldengate_log_dir }}
LOG_FILE=${LOG_DIR}/sync_auditdata_tables.log
TMP_SQL=/tmp/sync_auditdata_tables.sql

mkdir -p "${LOG_DIR}"
exec >>"${LOG_FILE}" 2>&1

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*"
}

log "Starting AUDITDATA table sync"

export ORACLE_SID={{ oracle_goldengate_group.auditdata.tns_alias }}
export ORACLE_HOME={{ oracle_goldengate_group.auditdata.oracle_home }}
export PATH=${ORACLE_HOME}/bin:$PATH

# Retrieve SYS password from AWS Secrets Manager
SYS_PASSWORD=$(aws secretsmanager get-secret-value \
  --secret-id "/oracle/database/${ORACLE_SID}/passwords" \
  --query 'SecretString' \
  --output text 2>/dev/null | jq -r '.sys' 2>/dev/null)

if [ -z "$SYS_PASSWORD" ]; then
  echo "ERROR: Cannot retrieve existing passwords secret for ${ORACLE_SID}"
  exit 1
fi

sqlplus -s sys/"${SYS_PASSWORD}"@${ORACLE_SID} as sysdba <<EOF
SET PAGESIZE 0 FEEDBACK OFF HEADING OFF ECHO OFF TRIMSPOOL ON TERMOUT OFF SERVEROUTPUT ON
WHENEVER SQLERROR EXIT SQL.SQLCODE
BEGIN
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'SQLTERMINATOR', true);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'PRETTY', true);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'SIZE_BYTE_KEYWORD', false);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'SEGMENT_ATTRIBUTES', false);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'STORAGE', false);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'REF_CONSTRAINTS', false);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'TABLESPACE', false);
  DBMS_METADATA.set_transform_param(DBMS_METADATA.session_transform, 'PARTITIONING', false);
END;
/
spool /tmp/sync_auditdata_tables.sql
WITH source_tables AS (
  SELECT o.owner, o.object_name, o.object_type
  FROM   dba_objects@{{ oracle_goldengate_group.source.tns_alias }} o
  WHERE  o.owner = '{{ oracle_goldengate_group.source.schema_owner }}'
  AND    o.object_type IN ('TABLE', 'CLUSTER')
  AND    EXISTS (
           SELECT 1 FROM dual d WHERE o.object_type = 'CLUSTER'
           UNION
           SELECT 1 FROM dba_tables@{{ oracle_goldengate_group.source.tns_alias }} t
            WHERE o.object_type = 'TABLE'
              AND t.owner = o.owner
              AND t.table_name = o.object_name
              AND (t.tablespace_name IS NOT NULL OR (t.tablespace_name IS NULL AND t.partitioned = 'YES'))
         )
),
source_signatures AS (
  SELECT c.table_name,
         LISTAGG(c.column_id || ':' || c.column_name || ':' || c.data_type || ':' ||
                 NVL(TO_CHAR(c.data_length), '-') || ':' || NVL(TO_CHAR(c.data_precision), '-') || ':' ||
                 NVL(TO_CHAR(c.data_scale), '-') || ':' || NVL(c.char_used, '-') || ':' ||
                 NVL(TO_CHAR(c.char_length), '-') || ':' || c.nullable, '|')
         WITHIN GROUP (ORDER BY c.column_id) AS column_signature
  FROM   dba_tab_cols@{{ oracle_goldengate_group.source.tns_alias }} c
  JOIN   source_tables s
    ON   s.object_type = 'TABLE'
   AND   s.owner = c.owner
   AND   s.object_name = c.table_name
  WHERE  c.hidden_column = 'NO'
  GROUP BY c.table_name
),
 target_signatures AS (
  SELECT c.table_name,
         LISTAGG(c.column_id || ':' || c.column_name || ':' || c.data_type || ':' ||
                 NVL(TO_CHAR(c.data_length), '-') || ':' || NVL(TO_CHAR(c.data_precision), '-') || ':' ||
                 NVL(TO_CHAR(c.data_scale), '-') || ':' || NVL(c.char_used, '-') || ':' ||
                 NVL(TO_CHAR(c.char_length), '-') || ':' || c.nullable, '|')
         WITHIN GROUP (ORDER BY c.column_id) AS column_signature
  FROM   dba_tab_cols c
  WHERE  c.owner = '{{ oracle_goldengate_group.auditdata.dummy_target_schema }}'
  AND    c.hidden_column = 'NO'
  GROUP BY c.table_name
),
changed_tables AS (
  SELECT s.object_name
  FROM   source_tables s
  JOIN   dba_objects t
    ON   t.owner = '{{ oracle_goldengate_group.auditdata.dummy_target_schema }}'
   AND   t.object_name = s.object_name
   AND   t.object_type = s.object_type
  LEFT JOIN source_signatures ss ON ss.table_name = s.object_name
  LEFT JOIN target_signatures ts ON ts.table_name = s.object_name
  WHERE  s.object_type = 'TABLE'
  AND    NVL(ss.column_signature, 'NO_SOURCE_COLUMNS') <> NVL(ts.column_signature, 'NO_TARGET_COLUMNS')
)
SELECT 'DROP TABLE {{ oracle_goldengate_group.auditdata.dummy_target_schema }}."' || object_name || '" CASCADE CONSTRAINTS;' || chr(10) ||
       replace(auditdata_dml_pkg.get_metadata_over_dblink('TABLE', '{{ oracle_goldengate_group.source.schema_owner }}', object_name),
               '{{ oracle_goldengate_group.source.schema_owner }}', '{{ oracle_goldengate_group.auditdata.dummy_target_schema }}')
FROM   changed_tables
ORDER BY object_name;
spool off
EXIT;
EOF

if [ -s "${TMP_SQL}" ]; then
    log "Applying generated SQL"
    sqlplus -s sys/"${SYS_PASSWORD}"@${ORACLE_SID} as sysdba <<EOF
SET ECHO ON FEEDBACK ON
@/tmp/sync_auditdata_tables.sql
BEGIN
  {{ oracle_goldengate_group.auditdata.schema_owner }}.auditdata_dml_pkg.apply_dml_conf;
END;
/
EXIT;
EOF
else
    log "No AUDITDATA table drift detected"
fi

rm -f "${TMP_SQL}"
log "AUDITDATA table sync complete"
