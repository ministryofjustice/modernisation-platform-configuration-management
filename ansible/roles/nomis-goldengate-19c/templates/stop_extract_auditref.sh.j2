#!/bin/bash
# GoldenGate Audit Reference Extract Stop Script
# Generated by Ansible

ORACLE_SID={{ oracle_goldengate_group.auditref.tns_alias }}
ORAENV_ASK=NO
. oraenv > /dev/null

GGHOME={{ oracle_goldengate_home }}
EXTRACT_NAME={{ oracle_goldengate_group.auditref.extract_name }}
LOG={{ oracle_goldengate_log_dir }}/ogg_control.log
OEM_AGENT_HOME=/u01/app/oracle/product/oem-agent/agent_13.5.0.0.0

echo "Creating blackout"
$OEM_AGENT_HOME/bin/emctl start blackout goldengate_maintenance_${ORACLE_SID} ${ORACLE_SID}:oracle_database

cd ${GGHOME}

echo "Stopping Extract ${EXTRACT_NAME}..."
echo "$(date '+%Y-%m-%d %H:%M:%S') - STOP EXTRACT ${EXTRACT_NAME}" >>"$LOG"

./ggsci << EOF >>"$LOG" 2>&1
STOP EXTRACT ${EXTRACT_NAME}
INFO EXTRACT ${EXTRACT_NAME}
EXIT
EOF

if [ $? -eq 0 ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Extract ${EXTRACT_NAME} stopped successfully" >>"$LOG"
    echo "Extract ${EXTRACT_NAME} stopped successfully"
    exit 0
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - FAILED to stop Extract ${EXTRACT_NAME}" >>"$LOG"
    echo "Failed to stop Extract ${EXTRACT_NAME}"
    exit 1
fi
