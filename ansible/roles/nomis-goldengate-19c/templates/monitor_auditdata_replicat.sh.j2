#!/bin/bash
# Monitor AUDITDATA Replicat and self-heal schema drift
# Generated by Ansible

. $HOME/.bash_profile

set -u

GGHOME={{ oracle_goldengate_home }}
PATH=${GGHOME}:/usr/local/bin:/bin:/usr/bin:/usr/local/sbin:/usr/sbin
GGSCI=${GGHOME}/ggsci
SCRIPTS_DIR={{ oracle_goldengate_scripts_dir }}
REPLICAT_NAME={{ oracle_goldengate_group.auditdata.replicat_name }}
SYNC_SCRIPT=${SCRIPTS_DIR}/sync_auditdata_tables.sh
LOG_DIR={{ oracle_goldengate_log_dir }}
LOG_FILE=${LOG_DIR}/auditdata_replicat_monitor.log
LOCK_FILE=${LOG_DIR}/auditdata_replicat_monitor.lock
MANUAL_STOP_FILE=${LOG_DIR}/auditdata_replicat_monitor.manual_stop
MAX_LOCK_AGE_SECONDS=7200

mkdir -p "${LOG_DIR}"
exec >>"${LOG_FILE}" 2>&1

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*"
}

cleanup() {
    rm -f "${LOCK_FILE}"
}

acquire_lock() {
    if [ -f "${LOCK_FILE}" ]; then
        local lock_age
        lock_age=$(( $(date +%s) - $(stat -f %m "${LOCK_FILE}" 2>/dev/null || stat -c %Y "${LOCK_FILE}") ))
        if [ "${lock_age}" -lt "${MAX_LOCK_AGE_SECONDS}" ]; then
            log "Another monitor run is active; exiting"
            exit 0
        fi
        log "Removing stale lock file"
        rm -f "${LOCK_FILE}"
    fi
    : > "${LOCK_FILE}"
    trap cleanup EXIT
}

replicat_status() {
    "${GGSCI}" <<EOF | awk '/^GGSCI|^REPLICAT/{print}'
INFO REPLICAT ${REPLICAT_NAME}
EXIT
EOF
}

set_oraenv() {
    # get the first ORACLE_SID from /etc/oratab and set the environment for Oracle commands.
    # doesn't matter which SID we use, we just need to set the environment for sqlplus and ggsci
    grep -v '^#' /etc/oratab | grep -v '^$' | grep -v '^+' | head -n 1 | cut -d: -f1 | while read -r sid; do
        export ORACLE_SID="${sid}"
        export ORAENV_ASK=NO
        . /usr/local/bin/oraenv > /dev/null 2>&1
        break
    done
}

# Set oraenv otherwise ggsci will error
set_oraenv
status_text=$(replicat_status)
status_rc=$?
#log "Replicat status check rc=${status_rc}"
#printf '%s
#' "${status_text}"

case "${status_text}" in
    *"STOPPED"*)
        if [ -f "${MANUAL_STOP_FILE}" ]; then
            log "Replicat is intentionally stopped; skipping self-heal"
            exit 0
        else
            log "Replicat is stopped; no stop file present; not running sync script"
        fi
        ;;
    *"ABENDED"*)
        log "Replicat is abended; running sync script"
        if ! "${SYNC_SCRIPT}"; then
            log "ERROR: sync script failed"
            exit 1
        fi
        log "Restarting replicat ${REPLICAT_NAME}"
        rm -f "${MANUAL_STOP_FILE}" >/dev/null 2>&1
        "${GGSCI}" <<EOF
START REPLICAT ${REPLICAT_NAME}
INFO REPLICAT ${REPLICAT_NAME}
EXIT
EOF
        if [ $? -ne 0 ]; then
            log "ERROR: failed to start replicat ${REPLICAT_NAME}"
            exit 1
        fi
        log "Replicat restart completed"
        ;;
    *"RUNNING"*)
        log "Replicat running; no action needed"
        ;;
    *)
        log "Replicat state not recognized; no action taken"
        ;;
esac
