#!/bin/bash
cd /home/oracle/admin/scripts
export ORACLE_SID={{ oracle_goldengate_group.mis.tns_alias }}
export ORAENV_ASK=NO
. /usr/local/bin/oraenv
sqlplus -s / as sysdba << EOF > /opt/textfile_monitoring/misload_success_status.prom
set head off feedback off pagesize 0
select decode(count(1),0, 'misload_success 0','misload_success 1')
from bodimis.etl_load_log
where load_start_datetime >= trunc(sysdate)
and load_start_datetime < trunc(sysdate) + 1
and (nvl(error_flag, 'Y') <> 'N' or load_end_datetime is null);
exit
EOF

