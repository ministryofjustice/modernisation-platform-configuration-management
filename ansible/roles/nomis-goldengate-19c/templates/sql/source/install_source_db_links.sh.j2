#!/bin/bash
# Script to install auditdata database links for Oracle GoldenGate
. ~/.bash_profile
export ORACLE_SID={{ oracle_goldengate_group.source.tns_alias }}
export ORACLE_HOME={{ oracle_goldengate_group.source.oracle_home }}
export PATH=${ORACLE_HOME}/bin:$PATH
export ORAENV_ASK=NO
. oraenv > /dev/null 2>&1

# Retrieve the MIS {{ oracle_goldengate_dbuser }} password from AWS Secrets Manager for creating the new db link.
# The db link script will get it from the env variable MIS_DB_PASSWORD.
export MIS_DB_PASSWORD=$(aws secretsmanager get-secret-value \
  --secret-id "/oracle/database/{{ oracle_goldengate_group.mis.tns_alias }}/passwords" \
  --query 'SecretString' \
  --output text 2>/dev/null | jq -r 'to_entries[] | select(.key | ascii_downcase == "{{ oracle_goldengate_dbuser | lower }}") | .value' 2>/dev/null)

if [ -z "$MIS_DB_PASSWORD" ]; then
  echo "ERROR: Failed to retrieve {{ oracle_goldengate_dbuser }} password from AWS Secrets Manager for {{ oracle_goldengate_group.mis.tns_alias }}"
  exit 1
fi

export SYS_PASSWORD=$(aws secretsmanager get-secret-value \
  --secret-id "/oracle/database/{{ oracle_goldengate_group.source.tns_alias }}/passwords" \
  --query 'SecretString' \
  --output text 2>/dev/null | jq -r '.sys' 2>/dev/null)

if [ -z "$SYS_PASSWORD" ]; then
  echo "ERROR: Failed to retrieve sys password from AWS Secrets Manager for {{ oracle_goldengate_group.source.tns_alias }}"
  exit 1
fi

cd {{ oracle_goldengate_sql_dir }}/source
sqlplus -s sys/"${SYS_PASSWORD}"@${ORACLE_SID} as sysdba @install_source_db_links.sql

exit 0
