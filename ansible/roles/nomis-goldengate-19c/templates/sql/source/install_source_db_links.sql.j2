spool /tmp/{{ oracle_goldengate_group_name }}_db_links.log

WHENEVER SQLERROR EXIT SUCCESS

PROMPT Installing database link to '{{ oracle_goldengate_group.mis.tns_alias }}' as {{ oracle_goldengate_group.mis.schema_owner }}

declare
    v_count integer;
    v_env_var varchar2(255) := 'MIS_DB_PASSWORD';
    v_mis_db_pwd varchar2(255);
begin
    dbms_system.get_env(v_env_var, v_mis_db_pwd);
    if v_mis_db_pwd is null then
      raise_application_error(-20001, 'MIS database password not found in environment variable '||v_env_var);
    end if;

    select count(*) into v_count from dba_db_links where db_link like 'CNOM_MIS_LINK%' and owner = 'PUBLIC';
    if v_count = 1 then
        execute immediate 'DROP PUBLIC DATABASE LINK CNOM_MIS_LINK';
    end if;
    execute immediate 'CREATE PUBLIC DATABASE LINK CNOM_MIS_LINK CONNECT TO {{ oracle_goldengate_group.mis.schema_owner }} IDENTIFIED BY "' || v_mis_db_pwd || '" USING ''{{ oracle_goldengate_group.mis.tns_alias }}''';
end;
/

