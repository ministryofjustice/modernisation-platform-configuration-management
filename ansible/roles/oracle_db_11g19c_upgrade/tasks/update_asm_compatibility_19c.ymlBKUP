---

# ASM Compatibility for Database should be increased to 18.10.0.0 on all Disk Groups

- name: Get Current RDBMS Compatibility Values
  script: get_asm_compatibility.sh
  register: asm_compatibility
  changed_when: false

- name: Update ASM Compatibility Values to 18.10.0.0 if currently a lower version
  script: set_asm_compatibility.sh {{ item.split(',')[0] }} {{ item.split(',')[1] }} "18.10.0.0"
  with_items: "{{ asm_compatibility.stdout_lines }}"
  when: 
     - item.split(',')[0] == 'compatible.rdbms'
     - item.split(',')[2] is version('18.10.0.0','<')
     
