{% if weblogic_db_hostname_b == "none" %}
{% for tnsnames_db in tnsnames_dbs %}
{{ tnsnames_db }} =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ weblogic_db_hostname_a }})(PORT = {{ tnsnames_port }}))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ tnsnames_db }})
    )
  )
{% endfor %}
{% else %}
{% for tnsnames_db in tnsnames_dbs %}
{{ tnsnames_db }} =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ weblogic_db_hostname_a }})(PORT = {{ tnsnames_port }}))
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ weblogic_db_hostname_b }})(PORT = {{ tnsnames_port }}))
    (FAILOVER = YES)
    (CONNECT_DATA =
      (SERVICE_NAME = {{ tnsnames_db }})
      (FAILOVER_MODE =
       (TYPE = SELECT)
       (METHOD = BASIC)
      )
    )
  )
{% endfor %}
{% endif %}
